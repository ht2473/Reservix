# =============================================================================
# Reservix — исключения системы контроля версий
# =============================================================================

# --- Секреты -----------------------------------------------------------------
# Файл .env содержит ключ приложения и пароли. В репозиторий попадает только
# шаблон .env.example с описанием переменных.
.env
.env.*
!.env.example
*.pem
*.key
!static/**/*.key

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Виртуальное окружение ---------------------------------------------------
# Файл uv.lock, напротив, коммитится: он обеспечивает воспроизводимость сборки.
.venv/
venv/
env/

# --- Django ------------------------------------------------------------------
# Собранная статика создаётся командой collectstatic при развёртывании.
staticfiles/
# Загруженные пользователями файлы. Каталог с примерами для демонстрации
# сохраняется отдельно, в db/media_fixtures/.
media/
!media/.gitkeep
logs/
*.log
db.sqlite3
db.sqlite3-journal

# --- Тесты и анализ ----------------------------------------------------------
.pytest_cache/
.pytest-media/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.hypothesis/
test-results/

# Отчёты нагрузочного тестирования: снимаются на развёрнутом стенде и
# описывают его состояние на момент прогона, а не свойство кодовой базы.
reports/
playwright-report/

# --- Локализация -------------------------------------------------------------
# Файлы .po коммитятся, скомпилированные .mo — нет: они собираются командой
# compilemessages при развёртывании.
*.mo

# --- Среды разработки --------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Служебное ---------------------------------------------------------------
*.bak
*.orig
.tmp/

# Отчёты подсчёта строк
