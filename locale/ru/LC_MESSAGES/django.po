msgid "Обработка персональных данных"
msgstr "Обработка персональных данных"

#: templates/portal/regulations.html:86
msgid ""
"\n"
"              Система обрабатывает персональные данные работников: сведения о\n"
"              должности, результаты оценки, участие в резерве. Объём обработки\n"
"              ограничен целями кадровой работы, доступ разграничен по роли и\n"
"              области видимости, действия с данными фиксируются в журнале\n"
"              аудита. Порядок обработки изложен в политике.\n"
"            "
msgstr ""
"\n"
"              Система обрабатывает персональные данные работников: сведения о\n"
"              должности, результаты оценки, участие в резерве. Объём обработки\n"
"              ограничен целями кадровой работы, доступ разграничен по роли и\n"
"              области видимости, действия с данными фиксируются в журнале\n"
"              аудита. Порядок обработки изложен в политике.\n"
"            "

