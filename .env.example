# =============================================================================
# Reservix — переменные окружения
# Скопируйте файл в `.env` и заполните значения.
# Ключ: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=замените-на-случайное-значение-не-менее-50-символов
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Идентификация -----------------------------------------------------------
SITE_DOMAIN=reservix.ru

# --- База данных -------------------------------------------------------------
DATABASE_URL=postgres://reservix:reservix@localhost:5432/reservix
DB_CONN_MAX_AGE=60

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Почта -------------------------------------------------------------------
# В разработке письма печатаются в консоль (задано в config/settings/dev.py).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Reservix <noreply@reservix.ru>
SERVER_EMAIL=reservix-system@reservix.ru

# --- Безопасность ------------------------------------------------------------
AXES_ENABLED=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Прочее ------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=26214400
SESSION_COOKIE_AGE=43200

# Получатели писем о критических ошибках: "Имя|адрес", через запятую.
DJANGO_ADMINS=

# --- Только для docker compose -----------------------------------------------
POSTGRES_DB=reservix
POSTGRES_USER=reservix
POSTGRES_PASSWORD=замените-на-надёжный-пароль
