# =============================================================================
# Reservix — ротация журналов
# Приложение пишет журналы в файлы, а не только в стандартный поток: разбор
# инцидента через неделю после него требует записей, а `docker logs` хранит
# ограниченный объём и обнуляется при пересоздании контейнера.
# =============================================================================

/var/log/reservix/*.log {
    # Ежедневно, хранить месяц: срок разбора инцидента в кадровой системе
    # измеряется днями, а не часами — жалоба на неверный расчёт индекса доходит
    # до администратора через неделю после самого расчёта.
    daily
    rotate 30
    missingok
    notifempty

    # Сжатие с задержкой на один цикл: вчерашний журнал остаётся читаемым
    # без распаковки, а он и нужен чаще всего.
    compress
    delaycompress

    # Права: журналы содержат адреса почты и идентификаторы записей, то есть
    # сведения ограниченного доступа.
    create 0640 reservix reservix
    su reservix reservix

    # Обработка выполняется один раз для всех файлов, а не для каждого.
    sharedscripts
    postrotate
        # Приложению сообщается о смене файла. Без этого gunicorn продолжает
        # писать в переименованный файл, и новый журнал остаётся пустым, пока
        # диск заполняется старым.
        /usr/bin/docker compose \
            --env-file /opt/reservix/.env \
            -f /opt/reservix/deploy/docker-compose.yml \
            kill -s USR1 web 2>/dev/null || true
    endscript
}

# Журнал резервного копирования ведётся отдельно и хранится дольше: по нему
# отвечают на вопрос «когда в последний раз проходило копирование», а этот
# вопрос задают именно тогда, когда копия понадобилась.
/var/log/reservix/backup.log {
    weekly
    rotate 26
    missingok
    notifempty
    compress
    delaycompress
    create 0640 reservix reservix
    su reservix reservix
}
