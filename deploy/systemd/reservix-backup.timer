# =============================================================================
# Расписание резервного копирования Reservix.
# =============================================================================

[Unit]
Description=Ежедневное резервное копирование Reservix
Requires=reservix-backup.service

[Timer]
# 03:30 — вне рабочих часов и вне окна автоматического обновления пакетов
# Ubuntu (06:00): копирование не должно совпасть с перезагрузкой.
OnCalendar=*-*-* 03:30:00

# Случайная задержка до пяти минут: при нескольких установках на одном
# гипервизоре одновременный дамп нескольких баз упирается в диск.
RandomizedDelaySec=300

# Пропущенный запуск выполняется при следующей загрузке. Ради этого свойства
# таймер и предпочтён записи в cron.
Persistent=true

[Install]
WantedBy=timers.target
